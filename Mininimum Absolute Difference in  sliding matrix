#include <stdio.h>
#include <stdlib.h>
#include <math.h>

// Comparison function for qsort
int compare(const void* a, const void* b) {
    int valA = *(const int*)a;
    int valB = *(const int*)b;
    if (valA < valB) return -1;
    if (valA > valB) return 1;
    return 0;
}

/**
 * Return an array of arrays of size (*returnSize), where each subarray has a size of (*returnColumnSizes).
 * Note: The returned array and its column sizes must be malloced.
 */
int** minAbsDiff(int** grid, int gridSize, int* gridColSize, int k, int* returnSize, int** returnColumnSizes) {
    int m = gridSize;
    int n = *gridColSize; // Dereference pointer to get column size
    
    // Result matrix configuration
    int resRows = m - k + 1;
    int resCols = n - k + 1;
    *returnSize = resRows;
    
    int** ans = (int**)malloc(resRows * sizeof(int*));
    *returnColumnSizes = (int*)malloc(resRows * sizeof(int));
    
    // Dynamic buffer to hold elements of a single k x k submatrix
    int* submatrixElements = (int*)malloc(k * k * sizeof(int));
    
    for (int i = 0; i < resRows; i++) {
        ans[i] = (int*)malloc(resCols * sizeof(int));
        (*returnColumnSizes)[i] = resCols;
        
        for (int j = 0; j < resCols; j++) {
            int count = 0;
            
            // Step 1: Collect elements from the current k x k submatrix
            for (int r = 0; r < k; r++) {
                for (int c = 0; c < k; c++) {
                    submatrixElements[count++] = grid[i + r][j + c];
                }
            }
            
            // Step 2: Sort the collected elements
            qsort(submatrixElements, count, sizeof(int), compare);
            
            // Step 3: Find the minimum difference between any two distinct values
            int minDiff = -1; // -1 indicates no two distinct values found yet
            for (int idx = 1; idx < count; idx++) {
                if (submatrixElements[idx] != submatrixElements[idx - 1]) {
                    int diff = submatrixElements[idx] - submatrixElements[idx - 1];
                    if (minDiff == -1 || diff < minDiff) {
                        minDiff = diff;
                    }
                }
            }
            
            // Step 4: If all elements are equal, result is 0, else minDiff
            ans[i][j] = (minDiff == -1) ? 0 : minDiff;
        }
    }
    
    free(submatrixElements);
    return ans;
}
