#include <stdio.h>
#include <string.h>
#include <stdlib.h>

int main() {
    // Allocate space for the input string based on constraints (up to 1000 characters)
    char num[1005];
    if (scanf("%1004s", num) != 1) return 0;
    
    // Array to hold frequencies of digits 0 to 9, initialized to zero
    int frequency[10] = {0};
    
    // Loop through each character of the string until the null terminator
    for (int i = 0; num[i] != '\0'; i++) {
        // Check if the current character is a digit
        if (num[i] >= '0' && num[i] <= '9') {
            // Convert character to integer index (e.g., '5' - '0' = 5)
            int digit = num[i] - '0';
            frequency[digit]++;
        }
    }
    
    // Print the ten space-separated frequencies
    for (int i = 0; i < 10; i++) {
        printf("%d ", frequency[i]);
    }
    printf("\n");
    
    return 0;
}
